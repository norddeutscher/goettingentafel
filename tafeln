// -------------------- DATENMODELL --------------------

class Gedenktafel {
  final String id;
  final String name;
  final String description;
  final String address;
  final String dates;
  final LatLng location;
  bool isFound;

  Gedenktafel({
    required this.id,
    required this.name,
    required this.description,
    required this.address,
    required this.dates,
    required this.location,
    this.isFound = false,
  });

  Map<String, dynamic> toJson() => {
    'id': id, 'name': name, 'description': description, 'address': address, 'dates': dates, 'isFound': isFound
  };

  factory Gedenktafel.fromJson(Map<String, dynamic> json) {
    return Gedenktafel(
      id: json['id'],
      name: json['name'],
      description: json['description'],
      address: json['address'],
      dates: json['dates'],
      location: const LatLng(51.5327, 9.9355), // Fallback Gänseliesel
      isFound: json['isFound'] ?? false,
    );
  }
}

