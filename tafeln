                  children: [
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                      decoration: BoxDecoration(color: Colors.blue[100], borderRadius: BorderRadius.circular(4)),
                      child: Text(tafel.description, style: TextStyle(color: Colors.blue[900], fontStyle: FontStyle.italic)),
                    ),
                    const SizedBox(height: 20),
                    const Row(children: [Icon(Icons.location_on, color: Colors.red, size: 20), SizedBox(width: 8), Text("Adresse:", style: TextStyle(fontWeight: FontWeight.bold))]),
                    Padding(padding: const EdgeInsets.only(left: 28), child: Text(tafel.address)),
                    const SizedBox(height: 15),
                    const Row(children: [Icon(Icons.access_time, color: Colors.orange, size: 20), SizedBox(width: 8), Text("Wohndauer:", style: TextStyle(fontWeight: FontWeight.bold))]),
                    Padding(padding: const EdgeInsets.only(left: 28), child: Text(tafel.dates)),
                    const SizedBox(height: 25),
                    SizedBox(width: double.infinity, child: OutlinedButton.icon(icon: const Icon(Icons.language), label: const Text("Auf Wikipedia suchen"), onPressed: () => _launchWiki(tafel.name))),
                    const SizedBox(height: 20),
                    const Divider(),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text("Gefunden?"),
                        Switch(
                          value: tafel.isFound,
                          activeColor: Colors.green,
                          onChanged: (val) {
                            _setFoundStatus(tafel, val);
                            setStateDialog(() {});
                            if (val) {
                              Navigator.of(context).pop();
                              ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('${tafel.name} eingesammelt!'), backgroundColor: Colors.green));
                            }
                          },
                        ),
                      ],
                    )
                  ],
                ),
              ),
              actions: [TextButton(child: const Text("Schließen"), onPressed: () => Navigator.of(context).pop())],
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    int foundCount = allTafeln.where((t) => t.isFound).length;
    double progress = allTafeln.isEmpty ? 0 : foundCount / allTafeln.length;
    String currentRank = _getRank(foundCount);

    Widget content;
    if (_selectedIndex == 0) {
      // --- LISTENANSICHT ---
      content = Column(
        children: [
          Container(
            padding: const EdgeInsets.all(16),
            color: Colors.blueAccent,
            child: Column(
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    const Text("Göttinger Tafeln", style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold, color: Colors.white)),
                    IconButton(
                      icon: Icon(_getFilterIcon(), color: _getFilterColor()),
                      onPressed: _cycleFilterMode,
                      tooltip: _getFilterTooltip(),
                    )
                  ],
                ),
                const SizedBox(height: 10),
                TextField(
                  onChanged: (val) { searchQuery = val; _applyFilters(); },
                  decoration: InputDecoration(
                    hintText: "Suche Name...", prefixIcon: const Icon(Icons.search), fillColor: Colors.white, filled: true,
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(30), borderSide: BorderSide.none), contentPadding: const EdgeInsets.symmetric(vertical: 0),
                  ),
                ),
                const SizedBox(height: 15),
                Row(children: [
                  Text("Rang: $currentRank", style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                  const Spacer(),
                  Text("$foundCount / ${allTafeln.length}", style: const TextStyle(color: Colors.white)),
                ]),
                const SizedBox(height: 5),
                LinearProgressIndicator(value: progress, backgroundColor: Colors.blue[800], valueColor: const AlwaysStoppedAnimation<Color>(Colors.greenAccent)),
              ],
            ),
          ),
          Expanded(
            child: isLoading
                ? const Center(child: CircularProgressIndicator())
                : ListView.builder(
              itemCount: filteredTafeln.length,
              itemBuilder: (context, index) {
                final tafel = filteredTafeln[index];
                return Card(
                  color: tafel.isFound ? Colors.green.shade50 : Colors.white,
                  margin: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  child: ListTile(
                    title: Text(tafel.name, style: TextStyle(fontWeight: FontWeight.bold, decoration: tafel.isFound ? TextDecoration.lineThrough : null, color: tafel.isFound ? Colors.green[900] : Colors.black)),
                    subtitle: Text(tafel.description, maxLines: 1, overflow: TextOverflow.ellipsis),
                    trailing: tafel.isFound ? const Icon(Icons.check_circle, color: Colors.green) : const Icon(Icons.chevron_right, color: Colors.grey),
                    onTap: () => _showDetailDialog(tafel),
                  ),
                );
              },
            ),
          ),
        ],
      );
    } else {
      // --- KARTENANSICHT ---
      // Wir zeigen hier die filteredTafeln an, damit der Filter auch auf der Karte wirkt
      final markers = filteredTafeln.map((tafel) {
        return Marker(
          point: tafel.location,
          width: 40,
          height: 40,
          child: GestureDetector(
            onTap: () => _showDetailDialog(tafel),
            child: Icon(
              Icons.location_on,
              color: tafel.isFound ? Colors.green : Colors.red,
              size: 40,
            ),
          ),
        );
      }).toList();

      if (_userLocation != null) {
        markers.add(
          Marker(
            point: _userLocation!,
            width: 50,
            height: 50,
            child: const Icon(
              Icons.my_location,
              color: Colors.blueAccent,
              size: 30,
            ),
          ),
        );
      }

      content = Stack(
        children: [
          FlutterMap(
            mapController: _mapController,
            options: const MapOptions(initialCenter: LatLng(51.532, 9.934), initialZoom: 14.0),
            children: [
              TileLayer(urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png', userAgentPackageName: 'com.example.goettingen_tafeln'),
              MarkerLayer(markers: markers),
            ],
          ),
          Positioned(
            bottom: 20,
            right: 20,
            child: FloatingActionButton(
              onPressed: () async {
                await _determinePosition();
                if (_userLocation != null) {
                  _mapController.move(_userLocation!, 16.0);
                }
              },
              child: const Icon(Icons.my_location),
            ),
          ),
          Positioned(
            top: 20,
            right: 20,
            child: FloatingActionButton.small(
              backgroundColor: _getFilterColor(),
              onPressed: _cycleFilterMode,
              child: Icon(_getFilterIcon(), color: Colors.blueAccent),
            ),
          )
        ],
      );
    }

    return Scaffold(
      body: SafeArea(child: content),
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _selectedIndex,
        onTap: (index) => setState(() => _selectedIndex = index),
        items: const [BottomNavigationBarItem(icon: Icon(Icons.list), label: 'Liste'), BottomNavigationBarItem(icon: Icon(Icons.map), label: 'Karte')],
      ),
    );
  }
}
