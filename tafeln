  @override
  void initState() {
    super.initState();
    filteredTafeln = allTafeln;
    _loadProgress();
    _determinePosition();
  }

  Future<void> _determinePosition() async {
    bool serviceEnabled;
    LocationPermission permission;

    serviceEnabled = await Geolocator.isLocationServiceEnabled();
    if (!serviceEnabled) {
      return;
    }

    permission = await Geolocator.checkPermission();
    if (permission == LocationPermission.denied) {
      permission = await Geolocator.requestPermission();
      if (permission == LocationPermission.denied) {
        return;
      }
    }

    if (permission == LocationPermission.deniedForever) {
      return;
    }

    Position position = await Geolocator.getCurrentPosition();
    setState(() {
      _userLocation = LatLng(position.latitude, position.longitude);
    });
  }

  Future<void> _loadProgress() async {
    final prefs = await SharedPreferences.getInstance();
    final String? savedData = prefs.getString('found_ids');
    if (savedData != null) {
      List<String> foundIds = List<String>.from(jsonDecode(savedData));
      setState(() {
        for (var tafel in allTafeln) {
          if (foundIds.contains(tafel.id)) {
            tafel.isFound = true;
          }
        }
        _applyFilters();
        isLoading = false;
      });
    } else {
      setState(() {
        isLoading = false;
      });
    }
  }

  Future<void> _saveProgress() async {
    final prefs = await SharedPreferences.getInstance();
    List<String> foundIds = allTafeln.where((t) => t.isFound).map((t) => t.id).toList();
    await prefs.setString('found_ids', jsonEncode(foundIds));
  }

  void _applyFilters() {
    setState(() {
      filteredTafeln = allTafeln.where((tafel) {
        final matchesSearch = searchQuery.isEmpty || tafel.name.toLowerCase().contains(searchQuery.toLowerCase());

        bool matchesFilter = true;
        switch (_filterMode) {
          case FilterMode.all: matchesFilter = true; break;
          case FilterMode.missing: matchesFilter = !tafel.isFound; break;
          case FilterMode.found: matchesFilter = tafel.isFound; break;
        }

        return matchesSearch && matchesFilter;
      }).toList();
    });
  }

  void _cycleFilterMode() {
    setState(() {
      if (_filterMode == FilterMode.all) {
        _filterMode = FilterMode.missing;
      } else if (_filterMode == FilterMode.missing) {
        _filterMode = FilterMode.found;
      } else {
        _filterMode = FilterMode.all;
      }
      _applyFilters();
    });
  }

  IconData _getFilterIcon() {
    switch (_filterMode) {
      case FilterMode.all: return Icons.filter_list;
      case FilterMode.missing: return Icons.search_off;
      case FilterMode.found: return Icons.check_circle;
    }
  }

  Color _getFilterColor() {
    switch (_filterMode) {
      case FilterMode.all: return Colors.white;
      case FilterMode.missing: return Colors.orangeAccent;
      case FilterMode.found: return Colors.greenAccent;
    }
  }

  String _getFilterTooltip() {
    switch (_filterMode) {
      case FilterMode.all: return "Zeige: Alle";
      case FilterMode.missing: return "Zeige: Nur Fehlende";
      case FilterMode.found: return "Zeige: Nur Gefundene";
    }
  }

  void _setFoundStatus(Gedenktafel tafel, bool status) {
    setState(() {
      tafel.isFound = status;
    });
    _saveProgress();
    _applyFilters();
  }

  String _getRank(int count) {
    if (count == 0) return "Erstsemester";
    if (count <= 10) return "Bummelstudent";
    if (count <= 25) return "Schein-Sammler";
    if (count <= 50) return "Bachelor-Absolvent";
    if (count <= 80) return "Master-Absolvent";
    if (count <= 120) return "Doktorand";
    if (count <= 170) return "Privatdozent";
    if (count <= 230) return "Professor";
    if (count <= 300) return "Dekan der Fakultät";
    return "Nobelpreisträger";
  }

  Future<void> _launchWiki(String name) async {
    final url = Uri.parse('https://de.wikipedia.org/w/index.php?search=$name');
    if (!await launchUrl(url, mode: LaunchMode.externalApplication)) {
      throw Exception('Could not launch $url');
    }
  }

